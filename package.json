{
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.7",
    "https-proxy-agent": "^7.0.6",
    "qrcode": "^1.5.4"
  },
  "description": "WeCom (企业微信) 智能机器人长连接桥接 for the Muse platform (file-queue backend)",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.10"
  },
  "name": "muse-wecom-bridge",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
